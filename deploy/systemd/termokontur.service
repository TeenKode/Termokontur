[Unit]
Description=Termokontur temperature-monitoring dashboard
After=network.target

[Service]
Type=simple
User=termokontur
Group=termokontur
WorkingDirectory=/opt/termokontur
EnvironmentFile=/etc/termokontur/termokontur.env
Environment=TERMOKONTUR_DB=/var/lib/termokontur/termokontur.sqlite3
# HTTPX uses certifi by default; honor administrators' Debian CA additions.
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ExecStart=/opt/termokontur/.venv/bin/python -m termokontur.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# Allow the dedicated unprivileged account to bind HTTPS on port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/termokontur
UMask=0077

[Install]
WantedBy=multi-user.target
