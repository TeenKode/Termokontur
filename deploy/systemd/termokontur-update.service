[Unit]
Description=Apply an approved Termokontur update from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/termokontur-apply-update
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# This privileged updater must replace systemd unit files and its own helper.
# Keep home isolation and no-new-privileges, but do not make /etc read-only.
ProtectSystem=no
