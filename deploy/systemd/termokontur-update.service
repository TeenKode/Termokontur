[Unit]
Description=Apply an approved Termokontur update from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/termokontur-apply-update
# Python dependency downloads may take considerably longer on slow school networks.
# The in-panel status keeps reporting the current step while systemd waits.
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# Keep /etc protected except for the explicit directories used during updates.
# The deployed unit must include both paths, even on installations predating this fix.
ProtectSystem=full
ReadWritePaths=/opt /var/lib/termokontur /etc/systemd/system /usr/local/sbin
