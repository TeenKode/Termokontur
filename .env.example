# Copy to .env only for Docker Compose. Never commit the real .env.
TERMOKONTUR_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TERMOKONTUR_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TERMOKONTUR_INGEST_KEY=REPLACE_WITH_A_LONG_RANDOM_DEVICE_KEY
MAX_BOT_TOKEN=
TERMOKONTUR_STALE_HOURS=26
TERMOKONTUR_TZ=Asia/Vladivostok
TERMOKONTUR_REMINDERS_ENABLED=0
TERMOKONTUR_REMINDER_TIME=09:00
TERMOKONTUR_REMINDER_DAYS=0,1,2,3,4
TERMOKONTUR_REMINDER_WINDOW_MINUTES=120
TERMOKONTUR_SECURE_COOKIE=0

# Runtime settings are imported into SQLite once. Change them later in Settings.
# The signing key TERMOKONTUR_SECRET remains an infrastructure secret.
