#!/usr/bin/env bash
# Root-owned fixed-action updater for native Debian LXC installations.
set -Eeuo pipefail
export GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 PIP_DISABLE_PIP_VERSION_CHECK=1
APP=/opt/termokontur
DATA=/var/lib/termokontur
PREV=/opt/termokontur-previous
BACKUPS="$DATA/backups"
STAGE=
SWAPPED=0
BACKUP_FILE=
SERVICES_SAVED=0
UNITS_DIR=/etc/systemd/system
OLD_UNITS=/opt/termokontur-previous-units
INSTALL_UNITS=(termokontur.service termokontur-max.service termokontur-update.service termokontur-update.path)

CURRENT_PHASE=preparing
UPDATE_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
record() {
  local state="$1" message="$2" phase="${3:-}"
  CURRENT_PHASE="$phase"
  runuser -u termokontur -- /usr/bin/python3 - "$state" "$message" "$phase" "$UPDATE_STARTED" "${REVISION:-}" "${BACKUP_FILE:-}" <<'PY'
import json, os, sys
from datetime import datetime, timezone
from pathlib import Path

p = Path("/var/lib/termokontur/update-status.json")
tmp = p.with_suffix(".json.tmp")
state, message, phase, started, revision, backup_file = sys.argv[1:]
now = datetime.now(timezone.utc).isoformat(timespec="seconds")
history = []
if phase != "preparing":
    try:
        previous = json.loads(p.read_text(encoding="utf-8"))
        if previous.get("started_at") == started and isinstance(previous.get("history"), list):
            history = previous["history"][-11:]
    except (OSError, ValueError, TypeError):
        pass
if not history or history[-1].get("phase") != phase:
    history.append({"phase": phase, "message": message[:200], "at": now})
payload = {
    "state": state, "message": message[:300], "phase": phase,
    "started_at": started, "updated_at": now, "history": history[-12:],
    "target_revision": revision if len(revision) == 40 else None,
    "backup_file": Path(backup_file).name if backup_file else None,
}
tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
tmp.chmod(0o600)
os.replace(tmp, p)
PY
}
health() {
  local attempt
  for attempt in $(seq 1 25); do
    if curl --fail --silent --max-time 2 http://127.0.0.1:8092/health >/dev/null || \
       curl --insecure --fail --silent --max-time 2 https://127.0.0.1:8092/health >/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}
# Fail before stopping services if the updater cannot replace system files.
# This protects the running application from partial upgrades in restricted LXC.
check_writable_dir() {
  local directory="$1" probe
  if ! probe=$(mktemp "$directory/.termokontur-update-probe.XXXXXXXX" 2>/dev/null); then
    echo "Updater cannot write to $directory; check systemd ProtectSystem and filesystem mount options" >&2
    return 1
  fi
  if ! install -m 0644 /dev/null "$probe"; then
    rm -f -- "$probe" || true
    echo "Updater cannot replace files in $directory" >&2
    return 1
  fi
  rm -f -- "$probe"
}
restore_db() {
  if [[ -n "$BACKUP_FILE" && -f "$BACKUP_FILE" ]]; then
    runuser -u termokontur -- /usr/bin/python3 - "$BACKUP_FILE" "$DATA/termokontur.sqlite3" <<'PY'
import sqlite3, sys
with sqlite3.connect(sys.argv[1]) as old, sqlite3.connect(sys.argv[2]) as target:
    old.backup(target)
PY
  fi
}
cleanup() {
  local result=$?
  trap - EXIT
  if (( result != 0 )); then
    if (( SWAPPED )); then
      systemctl stop termokontur-max.service 2>/dev/null || true
      systemctl stop termokontur.service 2>/dev/null || true
      if (( SERVICES_SAVED )); then
        for unit in "${INSTALL_UNITS[@]}"; do
          if [[ -f "$OLD_UNITS/$unit" ]]; then
            if ! install -o root -g root -m 0644 "$OLD_UNITS/$unit" "$UNITS_DIR/$unit"; then
              echo "WARNING: could not restore $unit; copy retained in $OLD_UNITS" >&2
            fi
          fi
        done
        systemctl daemon-reload || true
      fi
      if [[ -d "$APP" && -d "$PREV" ]]; then
        mv "$APP" "/opt/termokontur-failed-$$"
      fi
      if [[ -d "$PREV" ]]; then mv "$PREV" "$APP"; fi
      restore_db || true
      systemctl start termokontur.service || true
      if ! health; then echo "WARNING: rollback web health check failed" >&2; fi
      systemctl start termokontur-max.service || true
    fi
    record failed "Сбой на этапе: $CURRENT_PHASE. Действующая версия сохранена или выполнен откат. Подробности: journalctl -u termokontur-update.service" failed || true
  fi
  if [[ -n "$STAGE" && -d "$STAGE" ]]; then rm -rf -- "$STAGE"; fi
  exit "$result"
}
trap cleanup EXIT

[[ -f "$DATA/update-request" ]] || exit 0
runuser -u termokontur -- rm -f -- "$DATA/update-request"
record installing "Проверка прав и подготовка обновления…" preparing
check_writable_dir "$UNITS_DIR"
check_writable_dir "/usr/local/sbin"
STAGE=$(mktemp -d /opt/termokontur-stage.XXXXXXXX)
chown termokontur:termokontur "$STAGE"
record installing "Загружаем исходный код новой сборки с GitHub…" downloading
runuser -u termokontur -- git clone --depth 1 --single-branch --branch main \
  https://github.com/TeenKode/Termokontur.git "$STAGE"
REVISION=$(runuser -u termokontur -- git -C "$STAGE" rev-parse HEAD)
[[ "$REVISION" =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid revision" >&2; exit 1; }
if [[ -f "$DATA/installed-revision" ]] && [[ "$(cat "$DATA/installed-revision")" == "$REVISION" ]]; then
  record success "Уже установлена актуальная сборка." success
  exit 0
fi

record installing "Исходный код получен. Подготавливаем Python…" downloading
runuser -u termokontur -- /usr/bin/python3 -m venv "$STAGE/.venv"
record installing "Установка Python-зависимостей. Это может занять несколько минут…" dependencies
runuser -u termokontur -- "$STAGE/.venv/bin/python" -m pip install \
  --no-cache-dir -r "$STAGE/requirements.txt"
runuser -u termokontur -- "$STAGE/.venv/bin/python" -m compileall -q "$STAGE/termokontur"
bash -n "$STAGE/scripts/install-debian.sh" "$STAGE/scripts/termokontur-apply-update"
for unit in "${INSTALL_UNITS[@]}"; do
  [[ -f "$STAGE/deploy/systemd/$unit" ]] || { echo "Missing unit: $unit" >&2; exit 1; }
done
chown -R root:root "$STAGE"
chmod -R a+rX "$STAGE"
chmod 0755 "$STAGE"

record installing "Зависимости установлены. Подготавливаем резервную копию…" backup

# Backup SQLite online without stopping the running application.
install -o termokontur -g termokontur -m 0700 -d "$BACKUPS"
BACKUP_FILE="$BACKUPS/pre-update-$(date -u +%Y%m%dT%H%M%SZ)-$REVISION.sqlite3"
runuser -u termokontur -- /usr/bin/python3 - "$DATA/termokontur.sqlite3" "$BACKUP_FILE" <<'PY'
import sqlite3, sys
with sqlite3.connect(sys.argv[1]) as source, sqlite3.connect(sys.argv[2]) as target:
    source.backup(target)
PY
runuser -u termokontur -- chmod 0600 "$BACKUP_FILE"
record installing "Резервная копия сохранена. Переключаем приложение…" switching

systemctl stop termokontur-max.service 2>/dev/null || true
systemctl stop termokontur.service
if [[ -d "$PREV" ]]; then rm -rf -- "$PREV"; fi
mv "$APP" "$PREV"
SWAPPED=1
mv "$STAGE" "$APP"
STAGE=
systemctl start termokontur.service
record installing "Приложение запущено. Проверяем его доступность…" verifying
health || { echo "Web health check failed after version swap" >&2; exit 1; }

# Updated service units are installed only after the new app passes the first check.
if [[ -d "$OLD_UNITS" ]]; then rm -rf -- "$OLD_UNITS"; fi
install -d -o root -g root -m 0700 "$OLD_UNITS"
for unit in "${INSTALL_UNITS[@]}"; do
  cp -a "$UNITS_DIR/$unit" "$OLD_UNITS/$unit"
done
SERVICES_SAVED=1
for unit in "${INSTALL_UNITS[@]}"; do
  install -o root -g root -m 0644 "$APP/deploy/systemd/$unit" "$UNITS_DIR/$unit"
done
systemctl daemon-reload
systemctl restart termokontur.service
health || { echo "Web health check failed with updated service units" >&2; exit 1; }
systemctl start termokontur-max.service || true
systemctl enable --now termokontur-update.path

record installing "Проверка завершена. Сохраняем сведения о версии…" finishing

# Update the privileged updater itself last; validate it before installation.
install -o root -g root -m 0755 "$APP/scripts/termokontur-apply-update" /usr/local/sbin/termokontur-apply-update
runuser -u termokontur -- /usr/bin/python3 - "$REVISION" <<'PY'
from pathlib import Path
import sys
Path("/var/lib/termokontur/installed-revision").write_text(sys.argv[1] + "\n", encoding="ascii")
PY
record success "Обновление установлено: сборка ${REVISION:0:12}. Резервная копия сохранена." success
SWAPPED=0
exit 0
