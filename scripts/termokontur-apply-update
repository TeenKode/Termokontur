#!/usr/bin/env bash
# Root-owned fixed-action updater for native Debian LXC installations.
set -Eeuo pipefail
export GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 PIP_DISABLE_PIP_VERSION_CHECK=1
APP=/opt/termokontur
DATA=/var/lib/termokontur
PREV=/opt/termokontur-previous
BACKUPS="$DATA/backups"
STAGE=
SWAPPED=0
SERVICES_STOPPED=0
BACKUP_FILE=
SERVICES_SAVED=0
METADATA_CHANGED=0
UNITS_DIR=/etc/systemd/system
OLD_UNITS=/opt/termokontur-previous-units
INSTALL_UNITS=(termokontur.service termokontur-max.service termokontur-update.service termokontur-update.path)

CURRENT_PHASE=preparing
UPDATE_STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
record() {
  local state="$1" message="$2" phase="${3:-}"
  # Preserve the last operational phase if the terminal status write fails.
  if [[ "$phase" != success && "$phase" != failed ]]; then CURRENT_PHASE="$phase"; fi
  runuser -u termokontur -- /usr/bin/python3 - "$state" "$message" "$phase" "$UPDATE_STARTED" "${REVISION:-}" "${BACKUP_FILE:-}" <<'PY'
import json, os, sys
from datetime import datetime, timezone
from pathlib import Path

p = Path("/var/lib/termokontur/update-status.json")
tmp = p.with_suffix(".json.tmp")
state, message, phase, started, revision, backup_file = sys.argv[1:]
now = datetime.now(timezone.utc).isoformat(timespec="seconds")
history = []
if phase != "preparing":
    try:
        previous = json.loads(p.read_text(encoding="utf-8"))
        if previous.get("started_at") == started and isinstance(previous.get("history"), list):
            history = previous["history"][-11:]
    except (OSError, ValueError, TypeError):
        pass
if not history or history[-1].get("phase") != phase:
    history.append({"phase": phase, "message": message[:200], "at": now})
payload = {
    "state": state, "message": message[:300], "phase": phase,
    "started_at": started, "updated_at": now, "history": history[-12:],
    "target_revision": revision if len(revision) == 40 else None,
    "backup_file": Path(backup_file).name if backup_file else None,
}
tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
tmp.chmod(0o600)
os.replace(tmp, p)
PY
}
health() {
  local attempt
  for attempt in $(seq 1 25); do
    if curl --fail --silent --max-time 2 http://127.0.0.1:8092/health >/dev/null || \
       curl --insecure --fail --silent --max-time 2 https://127.0.0.1:443/health >/dev/null || \
       curl --insecure --fail --silent --max-time 2 https://127.0.0.1:8092/health >/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}
# Fail before stopping services if the updater cannot replace system files.
# This protects the running application from partial upgrades in restricted LXC.
check_writable_dir() {
  local directory="$1" probe
  if ! probe=$(mktemp "$directory/.termokontur-update-probe.XXXXXXXX" 2>/dev/null); then
    echo "Updater cannot write to $directory; check systemd ProtectSystem and filesystem mount options" >&2
    return 1
  fi
  if ! install -m 0644 /dev/null "$probe"; then
    rm -f -- "$probe" || true
    echo "Updater cannot replace files in $directory" >&2
    return 1
  fi
  rm -f -- "$probe"
}
reuse_python_environment() {
  local current="$APP/.venv" staged="$STAGE/.venv"
  [[ -d "$current" && ! -L "$current" ]] || return 1
  cmp -s "$APP/requirements.txt" "$STAGE/requirements.txt" || return 1
  # Keep a separate environment so staging and rollback do not edit the live one.
  cp -a --reflink=auto -- "$current" "$staged" || return 1
  runuser -u termokontur -- "$staged/bin/python" -m pip --quiet check || return 1
  # Check the top-level requirements too. An empty plan means every
  # requirement is already installed in the copy.
  runuser -u termokontur -- "$staged/bin/python" -m pip install \
    --no-index --dry-run --quiet --report - -r "$STAGE/requirements.txt" |
    /usr/bin/python3 -c 'import json, sys; plan = sys.stdin.read(); sys.exit(not plan or json.loads(plan)["install"] != [])'
}
restore_db() {
  if [[ -n "$BACKUP_FILE" && -f "$BACKUP_FILE" ]]; then
    runuser -u termokontur -- /usr/bin/python3 - "$BACKUP_FILE" "$DATA/termokontur.sqlite3" <<'PY'
import sqlite3, sys
with sqlite3.connect(sys.argv[1]) as old, sqlite3.connect(sys.argv[2]) as target:
    old.backup(target)
PY
  else
    return 1
  fi
}
write_revision() {
  # Run unprivileged: never follow a service-owned symlink as root.
  # Atomic replacement also works if an old marker is not writable.
  runuser -u termokontur -- /usr/bin/python3 - "$1" <<'PY'
import os, sys, tempfile
from pathlib import Path
target = Path("/var/lib/termokontur/installed-revision")
fd, name = tempfile.mkstemp(prefix=".installed-revision-", dir=target.parent)
try:
    with os.fdopen(fd, "w", encoding="ascii") as stream:
        stream.write(sys.argv[1] + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(name, target)
finally:
    Path(name).unlink(missing_ok=True)
PY
}
restore_metadata() {
  install -o root -g root -m 0755 "$OLD_UNITS/updater" /usr/local/sbin/termokontur-apply-update || return 1
  if [[ -f "$OLD_UNITS/revision" ]]; then
    write_revision "$(cat "$OLD_UNITS/revision")"
  else
    runuser -u termokontur -- rm -f -- "$DATA/installed-revision"
  fi
}
cleanup() {
  local result=$?
  local rollback_failed=0
  trap - EXIT
  if (( result != 0 )); then
    # Do not let another failed command abort error reporting and cleanup.
    set +e
    if (( SWAPPED )); then
      # Restoring SQLite while a new writer is still running is unsafe.
      local stop_failed=0
      systemctl stop termokontur-max.service || stop_failed=1
      systemctl stop termokontur.service || stop_failed=1
      if (( stop_failed )); then
        echo "ERROR: cannot stop writers for rollback; backups retained" >&2
        rollback_failed=1
      else
        if (( SERVICES_SAVED )); then
          for unit in "${INSTALL_UNITS[@]}"; do
            if [[ -f "$OLD_UNITS/$unit" ]]; then
              if ! install -o root -g root -m 0644 "$OLD_UNITS/$unit" "$UNITS_DIR/$unit"; then
                echo "WARNING: could not restore $unit; copy retained in $OLD_UNITS" >&2
                rollback_failed=1
              fi
            else
              rollback_failed=1
            fi
          done
          systemctl daemon-reload || rollback_failed=1
        fi
        if [[ -d "$APP" && -d "$PREV" ]]; then
          local failed_dir
          if failed_dir=$(mktemp -d /opt/termokontur-failed.XXXXXXXX); then
            mv -T -- "$APP" "$failed_dir/app" || rollback_failed=1
          else
            rollback_failed=1
          fi
        fi
        if [[ -d "$PREV" && ! -e "$APP" ]]; then
          mv -T -- "$PREV" "$APP" || rollback_failed=1
        else
          rollback_failed=1
        fi
        if ! restore_db; then
          echo "ERROR: could not restore database; snapshot retained: $BACKUP_FILE" >&2
          rollback_failed=1
        fi
        if (( METADATA_CHANGED )); then
          if ! restore_metadata; then
            echo "WARNING: could not restore updater metadata; copies retained in $OLD_UNITS" >&2
            rollback_failed=1
          fi
        fi
        # Do not start old code over an unconfirmed database restoration.
        if (( ! rollback_failed )); then
          systemctl start termokontur.service && health || rollback_failed=1
          systemctl start termokontur-max.service && systemctl is-active --quiet termokontur-max.service || rollback_failed=1
        fi
      fi
    elif (( SERVICES_STOPPED )); then
      systemctl start termokontur.service && health || rollback_failed=1
      systemctl start termokontur-max.service && systemctl is-active --quiet termokontur-max.service || rollback_failed=1
    fi
    if (( rollback_failed )); then
      record failed "Сбой на этапе: $CURRENT_PHASE. Восстановление не подтверждено. Не запускайте новое обновление до проверки журнала termokontur-update.service и резервных копий." failed || true
    else
      record failed "Сбой на этапе: $CURRENT_PHASE. Действующая версия сохранена или выполнен откат. Подробности: journalctl -u termokontur-update.service" failed || true
    fi
  fi
  if [[ -n "$STAGE" && -d "$STAGE" ]]; then rm -rf -- "$STAGE"; fi
  exit "$result"
}
trap cleanup EXIT

[[ -f "$DATA/update-request" ]] || exit 0
runuser -u termokontur -- rm -f -- "$DATA/update-request"
record installing "Проверка прав и подготовка обновления…" preparing
check_writable_dir "$UNITS_DIR"
check_writable_dir "/usr/local/sbin"
STAGE=$(mktemp -d /opt/termokontur-stage.XXXXXXXX)
chown termokontur:termokontur "$STAGE"
record installing "Загружаем исходный код новой сборки с GitHub…" downloading
runuser -u termokontur -- git clone --depth 1 --single-branch --branch stable \
  https://github.com/TeenKode/Termokontur.git "$STAGE"
REVISION=$(runuser -u termokontur -- git -C "$STAGE" rev-parse HEAD)
[[ "$REVISION" =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid revision" >&2; exit 1; }
if [[ -f "$DATA/installed-revision" ]] && [[ "$(cat "$DATA/installed-revision")" == "$REVISION" ]]; then
  record success "Уже установлена актуальная сборка." success
  exit 0
fi

record installing "Исходный код получен. Подготавливаем Python…" downloading
if reuse_python_environment; then
  record installing "Готовое Python-окружение проверено и скопировано." dependencies
else
  rm -rf -- "$STAGE/.venv"
  record installing "Устанавливаем Python-зависимости с локальным кешем…" dependencies
  runuser -u termokontur -- /usr/bin/python3 -m venv "$STAGE/.venv"
  runuser -u termokontur -- "$STAGE/.venv/bin/python" -m pip install \
    --cache-dir "$DATA/pip-cache" -r "$STAGE/requirements.txt"
fi
runuser -u termokontur -- "$STAGE/.venv/bin/python" -m compileall -q "$STAGE/termokontur"
bash -n "$STAGE/scripts/install-debian.sh" "$STAGE/scripts/termokontur-apply-update"
for unit in "${INSTALL_UNITS[@]}"; do
  [[ -f "$STAGE/deploy/systemd/$unit" ]] || { echo "Missing unit: $unit" >&2; exit 1; }
done
chown -R root:root "$STAGE"
chmod -R a+rX "$STAGE"
chmod 0755 "$STAGE"

# Before stopping either writer, download the published bundle for the exact
# candidate commit and validate the image, version and manifest. The Git tag
# is immutable per release; do not accept a manually uploaded or stale cache.
record installing "Проверяем и сохраняем комплект прошивки новой версии…" dependencies
(
  cd "$STAGE"
  runuser -u termokontur -- env TERMOKONTUR_DB="$DATA/termokontur.sqlite3" "$STAGE/.venv/bin/python" - "$REVISION" <<'PY'
import sys
from termokontur import sensor_firmware

data = sensor_firmware._download_git_bundle()
bundle = sensor_firmware.read_release(data)
if bundle.factory.source_commit != sys.argv[1]:
    raise SystemExit("Firmware bundle does not match the candidate panel revision")
sensor_firmware._store_release(data)
PY
)
record installing "Зависимости готовы. Подготавливаем резервную копию…" backup

# Quiesce both SQLite writers before taking the rollback snapshot. If any
# later preparation fails, cleanup restarts the unchanged installation.
SERVICES_STOPPED=1
systemctl stop termokontur-max.service
systemctl stop termokontur.service
install -o termokontur -g termokontur -m 0700 -d "$BACKUPS"
BACKUP_FILE="$BACKUPS/pre-update-$(date -u +%Y%m%dT%H%M%SZ)-$REVISION.sqlite3"
runuser -u termokontur -- /usr/bin/python3 - "$DATA/termokontur.sqlite3" "$BACKUP_FILE" <<'PY'
import sqlite3, sys
with sqlite3.connect(sys.argv[1]) as source, sqlite3.connect(sys.argv[2]) as target:
    source.backup(target)
PY
runuser -u termokontur -- chmod 0600 "$BACKUP_FILE"
record installing "Резервная копия сохранена. Переключаем приложение…" switching

if [[ -d "$PREV" ]]; then rm -rf -- "$PREV"; fi
mv "$APP" "$PREV"
SWAPPED=1
mv "$STAGE" "$APP"
STAGE=
# The new HTTPS listener needs CAP_NET_BIND_SERVICE on port 443.
# Install and retain rollback copies of systemd units before starting new code.
if [[ -d "$OLD_UNITS" ]]; then rm -rf -- "$OLD_UNITS"; fi
install -d -o root -g root -m 0700 "$OLD_UNITS"
for unit in "${INSTALL_UNITS[@]}"; do
  cp -a "$UNITS_DIR/$unit" "$OLD_UNITS/$unit"
done
cp -a /usr/local/sbin/termokontur-apply-update "$OLD_UNITS/updater"
if [[ -f "$DATA/installed-revision" ]]; then
  # Read as the service user, keep the snapshot root-owned.
  runuser -u termokontur -- cat "$DATA/installed-revision" > "$OLD_UNITS/revision"
fi
SERVICES_SAVED=1
for unit in "${INSTALL_UNITS[@]}"; do
  install -o root -g root -m 0644 "$APP/deploy/systemd/$unit" "$UNITS_DIR/$unit"
done
systemctl daemon-reload
systemctl start termokontur.service
record installing "Приложение запущено. Проверяем его доступность…" verifying
health || { echo "Web health check failed after version swap" >&2; exit 1; }
systemctl start termokontur-max.service
systemctl is-active --quiet termokontur-max.service
systemctl enable --now termokontur-update.path

record installing "Проверка завершена. Сохраняем сведения о версии…" finishing

# Update the privileged updater itself last; validate it before installation.
METADATA_CHANGED=1
install -o root -g root -m 0755 "$APP/scripts/termokontur-apply-update" /usr/local/sbin/termokontur-apply-update
write_revision "$REVISION"
record success "Обновление установлено: сборка ${REVISION:0:12}. Резервная копия сохранена." success
SWAPPED=0
exit 0
